# Browser (Vite). Local values come from `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Optional: shows a "Try the demo" button. The user must exist in Supabase Auth and be an editor of a workspace with is_demo = true.
# VITE_DEMO_EMAIL=
# VITE_DEMO_PASSWORD=

# Edge functions (set with `npx supabase secrets set` in the cloud, or supabase/functions/.env locally)
# QWEN_BASE_URL=
# QWEN_API_KEY=
# QWEN_MODEL=
